# Set these in the Vercel dashboard: Settings -> Environment Variables,
# then redeploy — Vercel does not apply new values to an existing build.
# Never commit real values.

# The site password, and the key that signs session cookies, so changing it
# logs every session out.
PORTAL_TOKEN=choose-a-long-random-string

# Read by /api/invoice to build receipts from the invoices database.
# The integration also needs the invoices, invoice lines and clients
# databases shared with it, or Notion answers 404.
NOTION_API_KEY=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
